# ============================================================================
# MailTide environment. Copy to `.env` and fill in. NEVER commit `.env`.
# ============================================================================

# --- MailTide's own database (PostgreSQL, via Prisma) -----------------------
# Holds ONLY auth + metadata (orgs, users, sessions, per-credential notes).
# No Postal key values are ever stored here.
DATABASE_URL="postgresql://mailtide:CHANGE_ME@127.0.0.1:5432/mailtide?schema=public"

# --- Postal's database (MariaDB/MySQL), READ-ONLY ---------------------------
# The single secret that grants MailTide its view of Postal. Use a dedicated
# read-only, table-scoped user (SELECT on `domains` + `credentials` only).
# See README "Postal read-only DB user" for the exact GRANT statements.
# MailTide runs with network_mode: host, so 127.0.0.1 reaches Postal's MariaDB.
POSTAL_DB_URL="mysql://mailtide_ro:CHANGE_ME@127.0.0.1:3306/postal"

# --- Postal public base URL -------------------------------------------------
# Used only to build the copy-ready env block shown to operators
# (POSTAL_API_URL = <this>/api/v1/send/message). MailTide does not call it.
POSTAL_API_BASE_URL="https://postal.sentire.solutions"

# --- Auth: the single seeded owner (created on first boot) ------------------
ADMIN_EMAIL="admin@sentire.solutions"
ADMIN_PASSWORD="CHANGE_ME_a_strong_admin_password"

# Signs the httpOnly session cookie. Generate with: openssl rand -hex 32
# Rotating this invalidates all existing sessions.
SESSION_SECRET="CHANGE_ME_openssl_rand_hex_32"

# --- Seed org (optional) ----------------------------------------------------
ORG_NAME="MailTide"

# NOTE: There is intentionally no MAILTIDE_ENCRYPTION_KEY and no
# POSTAL_ADMIN_API_KEY. Postal 3.3.7 has no management API; MailTide reads
# Postal's DB read-only and stores no key material, so neither is needed.
