# Where mailcow lives. The app signs in to IMAP and SMTP as the user.
IMAP_HOST=mx.sentire.solutions
IMAP_PORT=993
SMTP_HOST=mx.sentire.solutions
SMTP_PORT=587
# At least 32 random characters. In Dokploy, create it with generate_secret.
SESSION_SECRET=
# Domain shown as a hint on the sign-in page (optional).
MAIL_DOMAIN_HINT=mailtide.sentire.solutions
